    <script>
        // 資料狀態儲存庫
        var myPasta = { noodle: "", sauce: "", sauceColor: "", ingredients: [] };

        // 1. 麵條點擊（點擊立刻變色，且絕對不會噴任何錯）
        function goN(btn, name) {
            var btns = document.getElementById("noodleGroup").getElementsByTagName("button");
            for(var i=0; i<btns.length; i++) { btns[i].classList.remove("selected-n"); }
            btn.classList.add("selected-n");
            
            myPasta.noodle = name;
            document.getElementById("labelN").innerText = name;
            drawPastaPhoto();
        }

        // 2. 醬汁點擊
        function goS(btn, name, colorHex) {
            var btns = document.getElementById("sauceGroup").getElementsByTagName("button");
            for(var i=0; i<btns.length; i++) { btns[i].classList.remove("selected-s"); }
            btn.classList.add("selected-s");
            
            myPasta.sauce = name;
            myPasta.sauceColor = colorHex;
            document.getElementById("labelS").innerText = name;
            drawPastaPhoto();
        }

        // 3. 配料點擊 (複選)
        function goI(btn, name) {
            var idx = myPasta.ingredients.indexOf(name);
            if(idx > -1) {
                myPasta.ingredients.splice(idx, 1);
                btn.classList.remove("selected-i");
            } else {
                myPasta.ingredients.push(name);
                btn.classList.add("active-ing", "selected-i");
            }
            
            document.getElementById("labelI").innerText = myPasta.ingredients.length > 0 ? myPasta.ingredients.join(" + ") : "無";
            drawPastaPhoto();
        }

        // 🎨 核心：實體相片級立體融合引擎（加入防崩潰保護，變數沒好絕不強行畫圖）
        function drawPastaPhoto() {
            var canvas = document.getElementById("pastaCanvas");
            var ctx = canvas.getContext("2d");
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // 陶瓷大白盤背景
            ctx.beginPath();
            ctx.arc(150, 150, 140, 0, Math.PI * 2);
            ctx.fillStyle = "#FFFFFF"; ctx.fill();
            ctx.strokeStyle = "#EAEFF2"; ctx.lineWidth = 4; ctx.stroke();

            // 內圈浮雕槽
            ctx.beginPath();
            ctx.arc(150, 150, 110, 0, Math.PI * 2);
            ctx.strokeStyle = "#F1F3F5"; ctx.lineWidth = 2; ctx.stroke();

            // 融入光澤感濃郁醬汁
            if(myPasta.sauce && myPasta.sauceColor) {
                ctx.beginPath();
                ctx.arc(150, 150, 100, 0, Math.PI * 2);
                ctx.fillStyle = myPasta.sauceColor;
                ctx.fill();

                // 醬汁油亮照片質感高光膜
                var grad = ctx.createRadialGradient(120, 120, 5, 150, 150, 90);
                grad.addColorStop(0, "rgba(255, 255, 255, 0.15)");
                grad.addColorStop(1, "rgba(0, 0, 0, 0.05)");
                ctx.fillStyle = grad;
                ctx.beginPath(); ctx.arc(150, 150, 100, 0, Math.PI * 2); ctx.fill();

                // 🥩 正宗番茄肉醬：精準手工熬煮碎絞肉立體顆粒
                if(myPasta.sauce === '番茄肉醬') {
                    for(var i=0; i<85; i++) {
                        ctx.fillStyle = (Math.random() > 0.4) ? '#4A0808' : '#5C0E0E';
                        ctx.fillRect(90 + Math.random()*120, 90 + Math.random()*120, 3.5, 3.5);
                    }
                }
            }

            // 擬真3D實體麵條照片材質融入
            if(myPasta.noodle) {
                var pastaColor = (myPasta.sauce === "白醬") ? "#D1AD62" : "#FFEAA7";
                var shadowColor = (myPasta.sauce === "白醬") ? "#A4813D" : "#D4AF37";

                if(myPasta.noodle === "直麵") {
                    for (var i = 0; i < 40; i++) {
                        ctx.beginPath();
                        ctx.moveTo(80 + Math.random()*50, 80 + Math.random()*130);
                        ctx.bezierCurveTo(100 + Math.random()*100, 55 + Math.random()*150, 130 + Math.random()*100, 100 + Math.random()*100, 220 - Math.random()*50, 220 - Math.random()*140);
                        ctx.strokeStyle = shadowColor; ctx.lineWidth = 4.5; ctx.stroke();
                        ctx.strokeStyle = pastaColor; ctx.lineWidth = 3; ctx.stroke();
                    }
                } else if(myPasta.noodle === "螺旋麵") {
                    for (var i = 0; i < 22; i++) {
                        var x = 90 + Math.random() * 120; var y = 90 + Math.random() * 120;
